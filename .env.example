# Copy to ".env" and set the path to your Live install's Extension Host module.
# `extensions-cli run` reads this. See README "セットアップ" for how to find it.
#
# macOS example:
# EXTENSION_HOST_PATH=/Applications/Ableton Live 12 Suite.app/Contents/App-Resources/Extensions/ExtensionHostNodeModule.node
EXTENSION_HOST_PATH=
